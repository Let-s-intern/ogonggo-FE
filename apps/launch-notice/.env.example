# 신청 데이터를 받는 구글 앱스 스크립트 웹앱 주소.
# `docs/apps-script.gs` 를 스프레드시트에 붙여 넣고 배포하면 나오는 `/exec` 주소다.
#
# 이 값은 서버에서만 읽는다(`src/app/api/apply/route.ts`). `NEXT_PUBLIC_` 을 붙이지 마라 —
# 붙이는 순간 브라우저 번들에 들어가고, 그러면 누구나 시트에 행을 넣을 수 있다.
LAUNCH_NOTICE_SHEET_WEBHOOK_URL=

# 위 웹앱이 요구하는 공유 비밀. 앱스 스크립트 쪽 `SHARED_SECRET` 과 같은 값이어야 한다.
LAUNCH_NOTICE_SHEET_SECRET=
