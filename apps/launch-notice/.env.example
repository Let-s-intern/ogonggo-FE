# 포켓베이스 주소. Coolify 등에 띄운 인스턴스의 공개 주소.
POCKETBASE_URL=

# 슈퍼유저 계정. 신청 컬렉션의 규칙을 슈퍼유저 전용으로 잠가 두었기 때문에 서버가 이걸로
# 로그인해 행을 넣는다 — 규칙을 열면 주소를 아는 누구나 개인정보를 읽을 수 있다.
#
# 이 둘은 서버에서만 읽는다. NEXT_PUBLIC_ 을 붙이지 마라.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# `/admin` 화면이 브라우저에서 쓰는 주소. 위 POCKETBASE_URL 과 같은 값을 넣는다.
#
# 주소는 공개돼도 된다 — 컬렉션이 잠겨 있어 화면에서 사람이 로그인해야 목록이 보인다.
# 비밀번호는 여기 넣지 않는다. 넣으면 /admin 주소를 아는 누구나 신청자 전원을 보게 된다.
NEXT_PUBLIC_POCKETBASE_URL=

# 무료 홍보 신청을 영업 슬랙으로 알리는 백엔드. `POST /api/v1/advertisement-inquiries`.
# 없으면 알림만 건너뛰고 신청 저장은 그대로 된다.
ADVERTISEMENT_INQUIRY_API_ORIGIN=
