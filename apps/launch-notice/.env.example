# 구글 서비스 계정 JSON 을 통째로 한 줄에 넣는다.
#
# 왜 API 키가 아니라 서비스 계정인가: 구글 API 키는 "공개된 자원을 인증 없이 읽는" 용도라
# 시트에 쓰지 못한다 (sheets.googleapis.com 이 append 요청에 401 "API keys are not supported
# by this API" 를 준다). 사람 없이 서버가 쓰려면 주체가 있는 자격증명이 필요하다.
#
# 왜 JSON 통째인가: 개인 키(PEM)는 줄바꿈을 품고 있어 환경변수로 옮길 때 `\n` 이 깨지는 것이
# 가장 흔한 실패다. JSON 문자열 안에서는 이미 이스케이프돼 있고 JSON.parse 가 되돌려 준다.
#
# 만드는 법은 README 참고. 이 값은 서버에서만 읽는다 — NEXT_PUBLIC_ 을 붙이지 마라.
GOOGLE_SERVICE_ACCOUNT_JSON=

# 신청이 쌓일 스프레드시트 문서 ID.
# https://docs.google.com/spreadsheets/d/<여기가 ID>/edit — 44자쯤 되는 긴 문자열이다.
LAUNCH_NOTICE_SHEET_ID=
