# 목데이터(MSW)를 쓸지. 기본은 켜짐이다 — 지금 배포본이 MSW 기반이다.
#
# 실제 백엔드를 보려면 `false` 를 정확히 적는다. 오타나 빈 값은 켜진 것으로 본다
# (`src/instrumentation.ts`) — 조용히 꺼지면 데이터가 안 보이는 이유를 한참 찾게 된다.
#
# 서버가 뜰 때 어느 쪽인지 로그에 한 줄 찍는다.
OGONGGO_USE_MOCKS=

# 실제 백엔드 주소. 위를 끄면 여기로 나간다.
#
# 두 곳이 이 값을 읽는다 — `next.config.ts` 의 `/api/**` rewrite(브라우저용)와
# `packages/api/src/lib/http-client.ts`(서버 컴포넌트용). 비우면 http://localhost:8080 이다.
#
# 배포된 백엔드: https://qi9peez04m.execute-api.ap-northeast-2.amazonaws.com
#
# **이 값은 `next.config.ts` 가 빌드 시점에 읽어 rewrite 로 굽는다.** 배포 환경에서 값만 바꾸고
# 다시 빌드하지 않으면 이전 값이 그대로 서빙된다.
#
# 그리고 이 이름은 `turbo.json` 의 `build.env` 에 선언돼 있어야 빌드에 도달한다. turbo 2.x 는
# strict 환경변수 모드라 선언되지 않은 변수를 태스크에 넘기지 않는다. 선언을 빼면 기본값
# `http://localhost:8080` 이 구워지고, 버셀이 사설 주소로 나가는 rewrite 를 막아
# `/api/**` 가 전부 404(`x-vercel-error: DNS_HOSTNAME_RESOLVED_PRIVATE`) 가 된다.
# `NEXT_PUBLIC_` 접두사가 붙은 변수는 turbo 가 자동으로 통과시켜 이 문제를 겪지 않는다.
OGONGGO_USER_API_ORIGIN=

# 렛츠커리어 API 주소(호스트 루트, `/api` 미포함). 일반 회원 가입·로그인이 쓴다.
#
# 두 곳이 이 값을 읽는다 — `next.config.ts` 의 `/letscareer-api/**` rewrite 와 카카오·네이버 로그인 이동
# 주소(페이지 이동이라 rewrite 를 거치지 않는다). 비우면 rewrite 가 없어 일반 회원 로그인이 동작하지 않는다.
#
# 로컬과 배포 모두 렛츠커리어 prod 다. SSO 화이트리스트와 배포 오공고 백엔드가 prod 에 연결돼 있어서,
# 토큰을 발급한 곳과 오공고가 검증하러 가는 곳이 같아야 교환이 된다.
# NEXT_PUBLIC_ 이라 값이 빌드 시점에 박힌다. 배포 환경에서 바꾸면 다시 빌드해야 한다.
NEXT_PUBLIC_LETSCAREER_API_ORIGIN=https://3ccm7bgq1b.execute-api.ap-northeast-2.amazonaws.com

# Google Tag Manager 컨테이너 ID. 없으면 GTM 을 아예 싣지 않는다.
#
# **Vercel 의 Production 환경에만 넣는다.** 프리뷰에도 넣으면 배포마다 운영 GA 로 이벤트가
# 섞여 들어가고, 프리뷰에서 스무 번 눌러 본 것이 운영 지표가 된다.
#
# NEXT_PUBLIC_ 접두사는 Next 가 브라우저 번들에 넣기 위해 필요하다. 값이 빌드 시점에 박히므로
# 배포 환경에서 바꾸면 다시 빌드해야 반영된다.
NEXT_PUBLIC_GTM_ID=
