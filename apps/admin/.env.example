# 목데이터(MSW)를 쓸지. 기본은 켜짐이다 — 아홉 메뉴 중 백엔드가 있는 것은 넷(채용공고·부트캠프·
# 검수 대기·반려 보관) 뿐이라, 꺼지면 나머지 다섯 화면은 부를 API 가 없어 비어 있다.
#
# 실제 백엔드를 보려면 `false` 를 정확히 적는다. 오타나 빈 값은 켜진 것으로 본다
# (`src/app/enableMocking.ts`) — 조용히 꺼지면 데이터가 안 보이는 이유를 한참 찾게 된다.
#
# `apps/web` 의 `OGONGGO_USE_MOCKS` 와 같은 규칙이다. 접두사 `VITE_` 는 Vite 가 클라이언트
# 번들에 넣기 위해 필요하다.
#
# **값이 빌드 시점에 박힌다.** 배포 환경에서 바꾸면 다시 빌드해야 반영된다.
VITE_OGONGGO_USE_MOCKS=

# dev 서버가 /api/** 를 넘길 백엔드. 위를 끄면 여기로 나간다. 비우면 http://localhost:8081 이다.
#
# **dev 서버 전용이다.** `vite.config.ts` 의 `server.proxy` 가 쓰는 값이라 로컬에서만 동작한다.
# 버셀에 올라가는 것은 정적 파일뿐이라 프록시가 없고, 그래서 배포본에서 목을 끄면 `/api/**` 가
# 버셀 도메인 자신을 때려 404 가 된다. 배포본은 `apps/admin/vercel.json` 의 rewrite 가 대신
# 갈라 준다(`/api/v1/auth` 는 user API, 나머지 `/api` 는 admin API). **그 목적지는 이 변수를
# 읽지 않는다** — 버셀 rewrite 는 환경변수를 읽지 못해 주소가 파일에 직접 적혀 있다.
#
# 이 이름은 `turbo.json` 의 `build.env` 에 선언돼 있다. turbo 2.x 는 strict 환경변수 모드라
# 선언하지 않으면 빌드에 도달하지 않는다. 위의 `VITE_` 접두사 변수는 turbo 가 자동으로
# 통과시켜 선언이 필요 없다.
OGONGGO_ADMIN_API_ORIGIN=

# dev 서버가 /letscareer-api/** 를 넘길 렛츠커리어 API 주소(호스트 루트, `/api` 미포함).
# 관리자 로그인의 앞부분인 통합로그인(SSO) 이 여기로 나간다.
#
# 비우면 렛츠커리어 prod(https://3ccm7bgq1b.execute-api.ap-northeast-2.amazonaws.com) 다.
# 로컬에서도 prod 를 보는 이유는 `apps/web/.env.example` 의 `NEXT_PUBLIC_LETSCAREER_API_ORIGIN`
# 과 같다 — SSO 화이트리스트와 오공고 백엔드의 검증 대상이 prod 라, 토큰을 발급한 곳과 오공고가
# 검증하러 가는 곳이 같아야 교환이 된다. 로컬 렛츠커리어 서버(8080) 를 볼 때만 채운다.
#
# **dev 서버 전용이다.** 위 `OGONGGO_ADMIN_API_ORIGIN` 과 같은 이유로 배포본에는 프록시가 없고,
# `apps/admin/vercel.json` 의 rewrite 가 주소를 직접 들고 있다.
OGONGGO_LETSCAREER_API_ORIGIN=

# `오공고 웹으로`(좌측 메뉴 맨 아래)가 가는 웹 주소. 비우면 운영 주소(https://www.ogonggo.co.kr)다.
# 로컬 웹으로 보내 보려면 http://localhost:4000 을 넣는다(`src/shared/api/webHandoff.ts`).
#
# 누르면 들고 있는 오공고 토큰 둘을 웹의 `/auth/handoff` 에 넘겨 웹에서도 로그인된 채로 열린다.
# `VITE_` 접두사라 turbo 선언 없이 빌드에 닿고, 값은 빌드 시점에 박힌다.
VITE_OGONGGO_WEB_ORIGIN=

# UTM 링크 모달의 `단축링크 만들기` 가 부르는 Shlink 서버와 API 키.
#
# 브라우저에 두지 않는다. `VITE_` 접두사가 없어 번들에 들어가지 않고, 로컬에서는 `vite.config.ts` 의
# `/shlink-api/short-urls` 프록시가, 배포본에서는 서버리스 함수 `api/shlink-short-url.ts` 가 읽는다.
# 배포본은 버셀 프로젝트의 환경변수(Production)에 같은 이름으로 넣는다. 키는 저장소에 적지 않는다.
# 키가 없으면 로컬은 Shlink 의 401, 배포본은 503 `SHLINK_NOT_CONFIGURED` 로 답한다.
SHLINK_API_URL=https://l.letscareer.co.kr
SHLINK_API_KEY=

# Redash API 키. 통계 화면(`/stats`)이 Redash KPI 대시보드 v2 의 쿼리를 실행할 때 쓴다.
# Redash 프로필 화면의 API Key 를 넣는다. 그 계정이 볼 수 있는 쿼리를 모두 실행하게 해 주므로 조회 전용
# 계정의 키를 쓴다. `VITE_` 접두사가 없어 번들에는 들어가지 않는다.
#
# 로컬은 `vite.config.ts` 의 미들웨어가 읽는다. 배포본은 `api/redash-query.ts` 가 버셀 프로젝트의 서버
# 환경변수로 읽으므로 버셀 설정에 같은 이름으로 넣는다(재빌드 없이 반영된다).
REDASH_API_KEY=

# 어드민 AI 비서(오른쪽 아래 플로팅 채팅)의 모델(OpenAI 호환 chat/completions, 함수 호출을 지원해야 한다).
# 셋 중 하나라도 비면 비서가 설정 없음 오류를 낸다. 이름이 `STATS_` 로 시작하는 것은 통계 질문 창에서 먼저 썼기 때문이다.
# 카드뉴스(`apps/card-news/.env.example` 의 `CARD_LLM_*`)와 같은 방식이다.
#   DeepSeek  STATS_LLM_BASE_URL=https://api.deepseek.com  STATS_LLM_MODEL=deepseek-chat
#
# 로컬은 `vite.config.ts` 의 미들웨어가, 배포본은 `api/assistant.ts` 가 버셀 서버 환경변수로 읽는다.
STATS_LLM_BASE_URL=
STATS_LLM_API_KEY=
STATS_LLM_MODEL=
