# 오공고 공개 API. 공고 목록·상세·오늘의 공고를 여기서 읽는다.
OGONGGO_USER_API_ORIGIN=https://qi9peez04m.execute-api.ap-northeast-2.amazonaws.com

# AI 초안(OpenAI 호환 chat/completions). 셋 중 하나라도 비면 AI 없이 원문을 잘라 초안을 만든다.
#   DeepSeek  CARD_LLM_BASE_URL=https://api.deepseek.com  CARD_LLM_MODEL=deepseek-chat
#   Gemini    CARD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  CARD_LLM_MODEL=gemini-2.5-flash
CARD_LLM_BASE_URL=
CARD_LLM_API_KEY=
CARD_LLM_MODEL=

# 사진·건물 시안의 배경 후보 검색(선택). 없으면 공고 원문 대표 이미지와 직접 올린 이미지만 쓴다.
# https://developers.naver.com 에서 검색 API 를 신청해 받는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 또는 카카오(다음) 이미지 검색. https://developers.kakao.com 앱의 REST API 키.
KAKAO_REST_API_KEY=
