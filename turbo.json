{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "OGONGGO_USE_MOCKS",
        "OGONGGO_USER_API_ORIGIN",
        "OGONGGO_ADMIN_API_ORIGIN",
        "OGONGGO_SITE_ORIGIN"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "build:storybook": {
      "outputs": ["storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "codegen": {
      "cache": false,
      "env": ["OGONGGO_USER_API_URL", "OGONGGO_ADMIN_API_URL"],
      "outputs": ["src/generated/**"]
    }
  }
}
