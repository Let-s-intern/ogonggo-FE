{
  "name": "ogonggo-fe",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter admin dev",
    "mock": "pnpm --parallel --filter web --filter admin mock",
    "dev:admin": "pnpm --filter admin dev",
    "dev:web": "pnpm --filter web dev",
    "mock:admin": "pnpm --filter admin mock",
    "mock:web": "pnpm --filter web mock",
    "build": "turbo run build",
    "codegen": "turbo run codegen",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "format": "oxfmt write .",
    "storybook": "pnpm --filter ui storybook"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@<1.13.6": "1.13.6",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "tinypool@<2.1.2": "2.1.2",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "sharp@<0.35.5": "0.35.5",
      "fflate@>=0.7.0 <0.7.5": "0.7.5",
      "vite@>=8.2.0 <8.2.4": "8.2.4",
      "markdown-it@>=14.1.0 <14.3.3": "14.3.3",
      "happy-dom@>=17.0.0 <21.0.4": "21.0.4",
      "re2js@>=2.2.0 <2.8.7": "2.8.7"
    }
  }
}
